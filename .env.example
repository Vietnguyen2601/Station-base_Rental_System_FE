# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Application
REACT_APP_NAME=EV Rental System
REACT_APP_VERSION=1.0.0

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001/api

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false

# Logging
REACT_APP_LOG_LEVEL=info

# Database (if using Supabase)
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Third-party Services
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Error Reporting
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# Cloudinary (Vite)
VITE_CLOUDINARY_CLOUD_NAME=unsigned_preset
VITE_CLOUDINARY_UPLOAD_PRESET=dp73ww7yl
# Optional: place uploads into a specific folder
VITE_CLOUDINARY_MEDIA_FOLDER=vehicle-images
# Optional: supply API key when you implement signed uploads
VITE_CLOUDINARY_API_KEY=141268784427154